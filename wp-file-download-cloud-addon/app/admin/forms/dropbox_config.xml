<?xml version="1.0" encoding="UTF-8"?>
<form class="wpfdAddonparams" method="POST"
      action="admin.php?page=wpfdAddon-dropbox&amp;task=dropbox.saveDropboxParams">
    <label>Dropbox configuration</label>
    <input
            type="heading3"
            label="Dropbox"
            value=""
            class="ju-heading"
            namespace="Joomunited\WP_File_Download\Admin\Fields\"
    />
    <input
            name="dropboxKey"
            type="text2full"
            label="App Key"
            value=""
            class="ju-input ju-large-text"
            help=""
            namespace="Joomunited\WP_File_Download\Admin\Fields\"
    />
    <input
            name="dropboxSecret"
            type="text2full"
            label="App Secret"
            value=""
            class="ju-input ju-large-text"
            help=""
            namespace="Joomunited\WP_File_Download\Admin\Fields\"
    />
    <input
            name="dropboxAccessToken"
            type="hidden"
            namespace="Joomunited\WP_File_Download_Cloud_Addon\Admin\Fields\"
            default=""
        />
    <input
            type="containerstart"
            label="Container section"
            value=""
            class="inputbox input-block-level google-drive-sync-settings"
            namespace="Joomunited\WP_File_Download\Admin\Fields\"
    />
    <input type="radio2" name="dropboxSyncMethod" label="Sync Method" class="ju-input"
           help="The Dropbox synchronization method. Default is AJAX, advanced user only."
           namespace="Joomunited\WP_File_Download\Admin\Fields\">
        <option type="radio" class="ju-radiobox" name="dropboxSyncMethod" value="sync_page_curl">Use Curl</option>
        <option type="radio" class="ju-radiobox" name="dropboxSyncMethod" value="sync_page_curl_ajax">Use Ajax</option>
        <option type="radio" class="ju-radiobox" name="dropboxSyncMethod" value="setup_on_server">Crontab url</option>
    </input>
    <input type="select2" name="dropboxSyncTime" label="Sync periodicity" class="ju-input ju-large-text"
           default="30"
           help="Automatic Dropbox content synchronization delay. Default is 30 minutes."
           namespace="Joomunited\WP_File_Download\Admin\Fields\"
    >
        <option value="never">Never</option>
        <option value="5">5 Mins</option>
        <option value="15">15 Mins</option>
        <option value="30">30 Mins</option>
        <option value="60">1 Hour</option>
        <option value="300">5 Hour</option>
        <option value="600">10 Hour</option>
        <option value="1440">24 Hour</option>
        <option value="2880">48 Hour</option>
    </input>
    <input
            type="containerend"
            label="Container section end"
            value=""
            class="inputbox input-block-level"
            namespace="Joomunited\WP_File_Download\Admin\Fields\"
    />
    <input
            name="last_log"
            type="hidden"
            namespace="Joomunited\WP_File_Download_Cloud_Addon\Admin\Fields\"
            default=""/>
    <input
            name="dropboxBaseFolderId"
            class="dropboxBaseFolderId"
            type="hidden"
            namespace="Joomunited\WP_File_Download_Cloud_Addon\Admin\Fields\"
            default=""/>
    <input
            name="dropboxConnectedBy"
            type="hidden"
            namespace="Joomunited\WP_File_Download_Cloud_Addon\Admin\Fields\"
            default=""/>
    <button
            type="submit"
            value="Save Dropbox settings"
            class="ju-button orange-button ju-button-inline dropbox-submit"
            namespace="Joomunited\WP_File_Download\Admin\Fields\"
    />

</form>